# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
# Local Hive test box dirs (created at test runtime; box deletion in teardown
# intermittently hangs the test runner, so boxes persist across runs)
test/_hive_test_app_shell*/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
docs/*
.opencode/
!docs/followups.md
.superpowers/

# Symbolication related
app.*.symbols
.ignore

# Obfuscation related
app.*.map.json

# .NET build artifacts
PrintServer/bin/
PrintServer/obj/
PrintServer.Tests/bin/
PrintServer.Tests/obj/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
