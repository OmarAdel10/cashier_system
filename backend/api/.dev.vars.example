# Local-dev only — NEVER commit real values (this file is .gitignored).
TURSO_DATABASE_URL="https://your-db.turso.io"
TURSO_AUTH_TOKEN="get-from: turso db tokens create daftari"
POSTHOG_API_KEY="phc_..."
FIREBASE_PROJECT_ID="daftari-pos"
# Signs/verifies dashboard session JWTs — MUST equal the realtime worker's ADMIN_JWT_SECRET.
ADMIN_JWT_SECRET="local-test-secret"
# Shared secret for the realtime /internal/notify call — any local value works,
# but it MUST equal the realtime worker's INTERNAL_NOTIFY_SECRET.
INTERNAL_NOTIFY_SECRET="local-test-secret"
